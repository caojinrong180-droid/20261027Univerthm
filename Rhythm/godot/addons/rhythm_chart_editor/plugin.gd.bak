@tool
extends EditorPlugin
## 制谱器插件入口。
##
## 把自己注册成一个「主屏幕」（和 2D / 3D / Script 并列的那种标签页），
## 因为时间轴 + 舞台预览需要一个足够大的工作区，dock 面板塞不下。

const SCREEN_SCRIPT := preload("res://addons/rhythm_chart_editor/ui/chart_editor_screen.gd")

var _screen: Control = null


func _enter_tree() -> void:
	_screen = SCREEN_SCRIPT.new()
	_screen.name = "RhythmChartEditor"
	_screen.visible = false
	var host := EditorInterface.get_editor_main_screen()
	if host == null:
		push_error("Rhythm Chart Editor: 拿不到编辑器主屏幕容器")
		return
	# 编辑器启动阶段主屏幕可能正在装配子节点，直接 add_child 会被拒绝
	# （"Parent node is busy setting up children"），所以延迟挂载。
	host.add_child.call_deferred(_screen)


func _exit_tree() -> void:
	if is_instance_valid(_screen):
		if _screen.is_inside_tree():
			_screen.queue_free()
		else:
			_screen.free()
	_screen = null


func _has_main_screen() -> bool:
	return true


func _make_visible(visible: bool) -> void:
	if is_instance_valid(_screen):
		_screen.visible = visible


func _get_plugin_name() -> String:
	return "制谱器"


func _get_plugin_icon() -> Texture2D:
	var theme := EditorInterface.get_editor_theme()
	if theme:
		var icon := theme.get_icon("AudioStreamPlayer", "EditorIcons")
		if icon:
			return icon
	return null
