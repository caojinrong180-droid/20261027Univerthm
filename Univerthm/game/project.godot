; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Univerthm"
config/description="rchart 音游 · 读网页版制谱器导出的谱面"
run/main_scene="res://scenes/warning.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.png"
config/windows_native_icon="res://icon.ico"
; 不要引擎的 Godot 开屏：直接黑屏，进游戏第一帧就是光敏性警告
boot_splash/show_image=false
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/fullsize=false
boot_splash/minimum_display_time=0

[autoload]

App="*res://src/app.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"

[editor]

movie_writer/movie_file="D:/codexworkspace/Rhythmgame/Univerthm/game/outputvideo/test"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.043137, 0.05098, 0.070588, 1)
